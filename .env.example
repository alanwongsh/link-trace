# Postgres connection string. On Supabase: Connect → Connection string → Transaction pooler (port 6543).
# Any other Postgres works too. Keep this server-side only; never prefix it with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional. Used by `npm run db:migrate` instead of DATABASE_URL.
# On Supabase, use the session pooler (port 5432) or the direct connection.
# DATABASE_MIGRATION_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Password for the dashboard. Clicks stay public; stats do not.
ADMIN_PASSWORD=choose-a-long-password

# Optional. The app uses the request host when this is unset.
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
