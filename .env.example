# Supabase → Project Settings → API Keys
# Use the secret key (sb_secret_…). The publishable key (sb_publishable_…) cannot read the log.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key
# Password for the dashboard. Clicks stay public; stats do not.
ADMIN_PASSWORD=choose-a-long-password

# Optional. The app uses the request host when this is unset.
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
