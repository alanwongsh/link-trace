        <mxCell id="p1-context-staff" value="&lt;b&gt;Staff (browser)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;Sign in · links &amp; tags · parameters&lt;br&gt;placements · bulk CSV → QR zip · dashboard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#111827;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="p1-context-visitors" value="&lt;b&gt;Visitors&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;QR scans · link clicks&lt;br&gt;/r/:slug · /r/:slug/:tag · /q/:code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#111827;fontSize=14;" vertex="1" parent="1"><mxGeometry x="680" y="130" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="p1-context-next" value="&lt;b&gt;Next.js App&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#DBEAFE&quot;&gt;UI + server actions · auth/sessions · workspaces &amp; roles&lt;br&gt;Redirects /r and /q → 302 · jobs via enqueue()&lt;br&gt;Default inline: jobs run here after the response (after())&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="270" width="400" height="84" as="geometry" /></mxCell>
