        <mxCell id="ver-overview-v3-app" value="&lt;b&gt;Next.js (AWS)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#DBEAFE&quot;&gt;UI · auth · redirects · enqueue()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1075" y="236" width="300" height="64" as="geometry" /></mxCell>
        <mxCell id="ver-overview-v3-redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;BullMQ queues&lt;br&gt;(ElastiCache)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1025" y="340" width="150" height="74" as="geometry" /></mxCell>
        <mxCell id="ver-overview-v3-worker" value="&lt;b&gt;Node workers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;one or more&lt;br&gt;batch writes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1205" y="340" width="170" height="74" as="geometry" /></mxCell>
        <mxCell id="ver-overview-v3-pg" value="&lt;b&gt;PostgreSQL (RDS or Supabase)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;Still the single source of truth&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1025" y="450" width="350" height="50" as="geometry" /></mxCell>
        <mxCell id="ver-overview-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#6B7280;fontColor=#6B7280;" edge="1" parent="1" source="ver-overview-v3-clients" target="ver-overview-v3-app"><mxGeometry relative="1" as="geometry" /></mxCell>
