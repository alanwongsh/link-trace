        <mxCell id="ver-overview-tbl-head-0" value="&lt;b&gt;Compared&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#D1D5DB;fontSize=12;align=left;spacingLeft=10;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="230" height="34" as="geometry" /></mxCell>
