        <mxCell id="ver-overview-e9" value="reads · writes · inline jobs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2563EB;fontColor=#1D4ED8;" edge="1" parent="1" source="ver-overview-v1-app" target="ver-overview-v1-pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ver-overview-v2-app" value="&lt;b&gt;Next.js (Vercel or AWS)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#DBEAFE&quot;&gt;UI · auth · redirects · enqueue()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="595" y="236" width="300" height="64" as="geometry" /></mxCell>
        <mxCell id="ver-overview-v2-pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;App data&lt;br&gt;+ pgboss queue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="545" y="340" width="190" height="74" as="geometry" /></mxCell>
        <mxCell id="ver-overview-v2-worker" value="&lt;b&gt;Node worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;npm run worker&lt;br&gt;server / container&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="765" y="340" width="170" height="74" as="geometry" /></mxCell>
        <mxCell id="ver-overview-v2-queue" value="&lt;b&gt;Jobs wait as rows in the pgboss schema&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;Retries · hourly schedules · no time limit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#111827;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="450" width="390" height="50" as="geometry" /></mxCell>
