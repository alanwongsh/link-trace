        <mxCell id="scope-placements" value="&lt;b&gt;placements (labelled links)&lt;/b&gt;&lt;hr&gt;id · code (unique)&lt;br&gt;link_id FK · name&lt;br&gt;label key: one active per labels&lt;br&gt;legacy_tag · bulk_job_id FK" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=6;" vertex="1" parent="1"><mxGeometry x="790" y="360" width="210" height="130" as="geometry" /></mxCell>
        <mxCell id="scope-values" value="&lt;b&gt;placement_values&lt;/b&gt;&lt;hr&gt;placement_id FK&lt;br&gt;parameter_id FK&lt;br&gt;option_id FK · value" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=6;" vertex="1" parent="1"><mxGeometry x="790" y="520" width="210" height="110" as="geometry" /></mxCell>
        <mxCell id="scope-bulk" value="&lt;b&gt;bulk_jobs&lt;/b&gt;&lt;hr&gt;id · link_id FK&lt;br&gt;status · format · rows jsonb&lt;br&gt;total · processed · error&lt;br&gt;zip bytea · expires_at" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1040" y="360" width="210" height="130" as="geometry" /></mxCell>
        <mxCell id="scope-queue" value="&lt;b&gt;Queue storage&lt;/b&gt;&lt;hr&gt;V1: none&lt;br&gt;V2: pgboss.* in PostgreSQL&lt;br&gt;V3: Redis (BullMQ)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1040" y="520" width="210" height="110" as="geometry" /></mxCell>
        <mxCell id="scope-e6" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#059669;fontColor=#065F46;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="scope-ws" target="scope-links"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="scope-e7" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#059669;fontColor=#065F46;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="scope-links" target="scope-clicks"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="scope-e8" value="rolled up" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#059669;fontColor=#065F46;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="scope-clicks" target="scope-daily"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="scope-e9" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#059669;fontColor=#065F46;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="scope-ws" target="scope-params"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="scope-e10" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#059669;fontColor=#065F46;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="scope-params" target="scope-options"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="scope-e11" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#059669;fontColor=#065F46;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="scope-links" target="scope-placements"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="scope-e12" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#059669;fontColor=#065F46;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="scope-placements" target="scope-values"><mxGeometry relative="1" as="geometry" /></mxCell>
