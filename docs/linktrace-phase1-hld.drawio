  <diagram id="scope" name="5. Scope &amp; data">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="scope-t0" value="Phase 1 scope, data model &amp; path between versions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="36" as="geometry" /></mxCell>
        <mxCell id="scope-in" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#6EE7B7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="690" height="220" as="geometry" /></mxCell>
        <mxCell id="scope-t1" value="Built (works in every version)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="56" y="90" width="300" height="24" as="geometry" /></mxCell>
        <mxCell id="scope-t2" value="• Built-in auth, workspaces with timezones, viewer / editor / owner roles, audit log&lt;br&gt;• Links with platform tags (existing, unchanged)&lt;br&gt;• Labels (tracking parameters) per workspace: text or dropdown, CSV options&lt;br&gt;• Labelled links (/q/:code): one, picked combinations, or a CSV, with QR zips&lt;br&gt;• Daily totals (click_daily*) for fast reports, kept by click-rollup&lt;br&gt;• Dashboard and link reports · tags:migrate script&lt;br&gt;• Jobs through enqueue(): inline (V1) and pg-boss (V2) drivers" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#064E3B;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="120" width="660" height="176" as="geometry" /></mxCell>
        <mxCell id="scope-out" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#FECACA;arcSize=8;" vertex="1" parent="1"><mxGeometry x="770" y="80" width="690" height="220" as="geometry" /></mxCell>
        <mxCell id="scope-t3" value="Not built yet" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="786" y="90" width="400" height="24" as="geometry" /></mxCell>
        <mxCell id="scope-t4" value="• BullMQ driver and Redis (V3)&lt;br&gt;• Device routing (iOS / Android / fallback URLs) — task 6&lt;br&gt;• Bot and data-centre filtering — task 8&lt;br&gt;• PDPA changes after DPO review — task 9&lt;br&gt;• AWS hosting, CI/CD, branded domain — tasks 10–13&lt;br&gt;• S3 for QR zips instead of the database&lt;br&gt;• Role-based control beyond workspace roles" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#7F1D1D;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="786" y="120" width="660" height="176" as="geometry" /></mxCell>
        <mxCell id="scope-t5" value="Logical data model (same in every version)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="400" height="28" as="geometry" /></mxCell>
        <mxCell id="scope-ws" value="&lt;b&gt;workspaces&lt;/b&gt;&lt;hr&gt;id · name&lt;br&gt;timezone&lt;br&gt;(memberships: user, role)&lt;br&gt;(users · sessions · audit_log)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="210" height="130" as="geometry" /></mxCell>
        <mxCell id="scope-links" value="&lt;b&gt;links&lt;/b&gt;&lt;hr&gt;id · slug (unique)&lt;br&gt;workspace_id FK&lt;br&gt;kind · url / html&lt;br&gt;tags text[]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=6;" vertex="1" parent="1"><mxGeometry x="290" y="360" width="210" height="130" as="geometry" /></mxCell>
        <mxCell id="scope-clicks" value="&lt;b&gt;clicks&lt;/b&gt;&lt;hr&gt;id · link_id FK&lt;br&gt;visitor_id · ip · ua · country&lt;br&gt;is_bot · tag&lt;br&gt;placement_id FK (nullable)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=6;" vertex="1" parent="1"><mxGeometry x="290" y="520" width="210" height="130" as="geometry" /></mxCell>
        <mxCell id="scope-daily" value="&lt;b&gt;click_daily · _link · _dim&lt;/b&gt;&lt;hr&gt;link_id · placement_id · day&lt;br&gt;clicks · visitors (· ips · bots)&lt;br&gt;dim · value (by place, device…)&lt;br&gt;(rollup_progress per timezone)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=6;" vertex="1" parent="1"><mxGeometry x="290" y="680" width="210" height="130" as="geometry" /></mxCell>
        <mxCell id="scope-params" value="&lt;b&gt;tracking_parameters (labels)&lt;/b&gt;&lt;hr&gt;id · workspace_id FK&lt;br&gt;key (fixed) · name&lt;br&gt;field_type · is_active&lt;br&gt;sort_order" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=6;" vertex="1" parent="1"><mxGeometry x="540" y="360" width="210" height="130" as="geometry" /></mxCell>
