        <mxCell id="ctx-v3-staff" value="&lt;b&gt;Staff (browser)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;Sign in · links · labels (parameters)&lt;br&gt;labelled links · bulk CSV → QR zip · reports&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#111827;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="ctx-v3-visitors" value="&lt;b&gt;Visitors&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;QR scans · link clicks&lt;br&gt;/r/:slug · /r/:slug/:tag · /q/:code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#111827;fontSize=14;" vertex="1" parent="1"><mxGeometry x="680" y="130" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="ctx-v3-e4" value="Sign in · manage · upload CSV" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#6B7280;fontColor=#6B7280;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="ctx-v3-staff" target="ctx-v3-app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ctx-v3-e5" value="Scan / click → 302" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#6B7280;fontColor=#6B7280;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="ctx-v3-visitors" target="ctx-v3-app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ctx-v3-app" value="&lt;b&gt;Next.js (AWS)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#DBEAFE&quot;&gt;UI + server actions · auth/sessions · workspace roles · redirects /r and /q → 302&lt;br&gt;enqueue(job) → BullMqDriver: the job is pushed to Redis, the request ends&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="270" width="600" height="96" as="geometry" /></mxCell>
        <mxCell id="ctx-v3-t6" value="DATA &amp; QUEUE — POSTGRESQL + REDIS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#9CA3AF;" vertex="1" parent="1"><mxGeometry x="56" y="418" width="400" height="20" as="geometry" /></mxCell>
        <mxCell id="ctx-v3-pg" value="&lt;b&gt;PostgreSQL — app data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;users · workspaces (timezone) · memberships · audit_log&lt;br&gt;links (tags) · clicks · labelled links (placements, values)&lt;br&gt;click_daily · click_daily_link · click_daily_dim (report totals)&lt;br&gt;bulk_jobs (status, progress, QR zip for 7 days)&lt;br&gt;(no queue tables)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="440" width="560" height="112" as="geometry" /></mxCell>
        <mxCell id="ctx-v3-redis" value="&lt;b&gt;Redis + BullMQ (ElastiCache)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;Queues: the same five jobs&lt;br&gt;Fast in-memory writes: clicks no longer cost a database write each&lt;br&gt;Retries · backoff · repeatable jobs (hourly schedules)&lt;br&gt;Driver gathers clicks into batches for record-click&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#111827;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="440" width="470" height="112" as="geometry" /></mxCell>
        <mxCell id="ctx-v3-t7" value="WORKERS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#9CA3AF;" vertex="1" parent="1"><mxGeometry x="56" y="598" width="300" height="20" as="geometry" /></mxCell>
        <mxCell id="ctx-v3-worker" value="&lt;b&gt;Node.js workers (npm run worker)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;Scale out by running more · each job handled once&lt;br&gt;Batched click inserts · bulk QR · totals&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#111827;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="615" width="420" height="74" as="geometry" /></mxCell>
        <mxCell id="ctx-v3-e8" value="Reads/writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2563EB;fontColor=#1D4ED8;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ctx-v3-app" target="ctx-v3-pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ctx-v3-e9" value="enqueue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#991B1B;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ctx-v3-app" target="ctx-v3-redis"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ctx-v3-e10" value="Consume jobs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#DC2626;fontColor=#991B1B;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="ctx-v3-redis" target="ctx-v3-worker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ctx-v3-e11" value="Batched clicks · labelled links · QR zips · totals" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#4F46E5;fontColor=#3730A3;exitX=0.25;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="ctx-v3-worker" target="ctx-v3-pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ctx-v3-note" value="&lt;b&gt;To build:&lt;/b&gt; lib/jobs/bullmq-driver.ts implementing QueueDriver (REDIS_URL; singletonKey → job id; retry → attempts + backoff; schedule → repeatable job; batch clicks before calling the handler), and a &quot;bullmq&quot; case in create-driver.ts. Then let the pgboss queue empty and set QUEUE_DRIVER=bullmq for the app and the workers." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#93C5FD;fontSize=11;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1200" height="70" as="geometry" /></mxCell>
        <mxCell id="ctx-v3-legend" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1200" height="70" as="geometry" /></mxCell>
        <mxCell id="ctx-v3-t12" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="56" y="826" width="60" height="20" as="geometry" /></mxCell>
        <mxCell id="ctx-v3-l1" value="Next.js" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="56" y="852" width="110" height="26" as="geometry" /></mxCell>
        <mxCell id="ctx-v3-l2" value="PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="176" y="852" width="110" height="26" as="geometry" /></mxCell>
