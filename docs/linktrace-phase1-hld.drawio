        <mxCell id="ctx-v1-band-data" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F9FAFB;strokeColor=#E5E7EB;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="1200" height="160" as="geometry" /></mxCell>
