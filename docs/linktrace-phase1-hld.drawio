        <mxCell id="p1-context-l4" value="Node worker" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#111827;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="498" y="756" width="110" height="28" as="geometry" /></mxCell>
        <mxCell id="p1-context-l5" value="Later" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#6B7280;dashed=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="622" y="756" width="110" height="28" as="geometry" /></mxCell>
        <mxCell id="p1-context-t14" value="PoC on Vercel: Next.js + PostgreSQL only. Add the worker with QUEUE_DRIVER=pgboss. No Redis in Phase 1." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="750" y="756" width="470" height="28" as="geometry" /></mxCell>
        <mxCell id="p1-context-note" value="&lt;b&gt;PoC intent:&lt;/b&gt; Prove configurable labels, placements and bulk QR with the least infrastructure. Every job goes through enqueue() and one setting, QUEUE_DRIVER: inline (default, runs in the app, works on Vercel) → pgboss (Postgres queue + worker) → bullmq (Redis, later). Each step changes one driver, not the app. Existing /r links, tags and stats keep working unchanged." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1200" height="70" as="geometry" /></mxCell>
