        <mxCell id="ver-overview-tbl-head-2" value="&lt;b&gt;V2 — Database queue + worker&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#D1D5DB;fontSize=12;align=left;spacingLeft=10;arcSize=4;" vertex="1" parent="1"><mxGeometry x="680" y="590" width="390" height="34" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-head-3" value="&lt;b&gt;V3 — Redis + BullMQ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#D1D5DB;fontSize=12;align=left;spacingLeft=10;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1080" y="590" width="390" height="34" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-0-0" value="&lt;b&gt;Processes&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="230" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-0-1" value="Next.js + PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="280" y="630" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-0-2" value="+ Node worker" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="680" y="630" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-0-3" value="+ Node worker(s) + Redis" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="1080" y="630" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-1-0" value="&lt;b&gt;Where jobs wait&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="688" width="230" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-1-1" value="Nowhere: each job runs in the app right after the response (after())" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="280" y="688" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-1-2" value="Rows in the pgboss schema of the same PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="680" y="688" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-1-3" value="Redis (BullMQ)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="1080" y="688" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-2-0" value="&lt;b&gt;Clicks (record-click)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="746" width="230" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-2-1" value="Saved right after the redirect, one insert per visit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="280" y="746" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-2-2" value="Queued, saved by the worker in batches of up to 200" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="680" y="746" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-2-3" value="Queued in Redis, batched into PostgreSQL: takes write load off the database" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="1080" y="746" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-3-0" value="&lt;b&gt;Bulk QR (bulk-placements)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="804" width="230" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-3-1" value="Runs after Create; limited by the request time (Vercel maxDuration; Hobby 60 s)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="280" y="804" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-3-2" value="Worker job, up to 15 min; progress shown on the link page" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="680" y="804" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-3-3" value="Worker job; workers scale out" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="1080" y="804" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-4-0" value="&lt;b&gt;Scheduled jobs (click-rollup, bulk-cleanup)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="230" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-4-1" value="No clock: report pages start click-rollup when totals are behind; cleanup runs after each upload" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="280" y="862" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-4-2" value="Worker clock: both hourly" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="680" y="862" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-4-3" value="BullMQ repeatable jobs: both hourly" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="1080" y="862" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-5-0" value="&lt;b&gt;Retries · crash recovery&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="230" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-5-1" value="None: one attempt, failures logged" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="280" y="920" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-5-2" value="Yes: retry with delay; stuck jobs released" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="680" y="920" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-5-3" value="Yes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="1080" y="920" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-6-0" value="&lt;b&gt;Hosting&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="978" width="230" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-6-1" value="Vercel + Supabase" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="280" y="978" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-6-2" value="App on Vercel or AWS; worker on a server or container; worker uses the Supabase session pooler" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="680" y="978" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-6-3" value="AWS: app, workers, RDS, ElastiCache" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="1080" y="978" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-7-0" value="&lt;b&gt;Move here when&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="1036" width="230" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-7-1" value="Start here (PoC)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="280" y="1036" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-7-2" value="Bulk uploads hit the time limit, or retries and schedules are needed, or on AWS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="680" y="1036" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-7-3" value="Click volume strains PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="1080" y="1036" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-8-0" value="&lt;b&gt;Change needed&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="1094" width="230" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-8-1" value="None" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="280" y="1094" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-8-2" value="Set QUEUE_DRIVER=pgboss for app and worker; run npm run worker" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="680" y="1094" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-tbl-8-3" value="Write BullMqDriver; add REDIS_URL; let the pgboss queue empty; set QUEUE_DRIVER=bullmq" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;arcSize=4;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="1080" y="1094" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="ver-overview-note" value="&lt;b&gt;How the code stays the same:&lt;/b&gt; every job is listed in lib/jobs/catalog.ts (record-click · bulk-placements · bulk-cleanup · click-rollup · rebuild-totals) and started with enqueue(name, data). lib/jobs/create-driver.ts turns QUEUE_DRIVER into a driver: InlineDriver (V1), PgBossDriver (V2), BullMqDriver (V3, to write). Redirects, labelled links, bulk QR, reports and the data model do not change between versions." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#93C5FD;fontSize=11;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="1162" width="1430" height="56" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
