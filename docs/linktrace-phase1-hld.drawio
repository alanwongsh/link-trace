        <mxCell id="ctx-v2-e4" value="Sign in · manage · upload CSV" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#6B7280;fontColor=#6B7280;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="ctx-v2-staff" target="ctx-v2-app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ctx-v2-e5" value="Scan / click → 302" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#6B7280;fontColor=#6B7280;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="ctx-v2-visitors" target="ctx-v2-app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ctx-v2-app" value="&lt;b&gt;Next.js (Vercel or AWS)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#DBEAFE&quot;&gt;UI + server actions · auth/sessions · workspace roles · redirects /r and /q → 302&lt;br&gt;enqueue(job) → PgBossDriver: the job is written to the queue and the request ends&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="270" width="600" height="96" as="geometry" /></mxCell>
        <mxCell id="ctx-v2-t6" value="DATA &amp; QUEUE — ONE POSTGRESQL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#9CA3AF;" vertex="1" parent="1"><mxGeometry x="56" y="418" width="400" height="20" as="geometry" /></mxCell>
        <mxCell id="ctx-v2-pg" value="&lt;b&gt;PostgreSQL — app data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;users · workspaces (timezone) · memberships · audit_log&lt;br&gt;links (tags) · clicks · labelled links (placements, values)&lt;br&gt;click_daily · click_daily_link · click_daily_dim (report totals)&lt;br&gt;bulk_jobs (status, progress, QR zip for 7 days)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="440" width="560" height="112" as="geometry" /></mxCell>
        <mxCell id="ctx-v2-queue" value="&lt;b&gt;Job queue (pgboss schema, same database)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;Jobs wait as rows; a worker claims each one (row lock, SKIP LOCKED)&lt;br&gt;record-click · bulk-placements · bulk-cleanup · click-rollup · rebuild-totals&lt;br&gt;Retries with delay · stuck jobs released · hourly schedules&lt;br&gt;click-rollup :07 · bulk-cleanup :17 every hour&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#111827;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="440" width="470" height="112" as="geometry" /></mxCell>
        <mxCell id="ctx-v2-t7" value="WORKER" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#9CA3AF;" vertex="1" parent="1"><mxGeometry x="56" y="598" width="300" height="20" as="geometry" /></mxCell>
        <mxCell id="ctx-v2-worker" value="&lt;b&gt;Node.js worker (npm run worker)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;Server or container, not Vercel · any number can run&lt;br&gt;Bulk QR up to 15 min · clicks in batches of 200 · Supabase session pooler&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#111827;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="615" width="420" height="74" as="geometry" /></mxCell>
        <mxCell id="ctx-v2-e8" value="Reads/writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2563EB;fontColor=#1D4ED8;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ctx-v2-app" target="ctx-v2-pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ctx-v2-e9" value="enqueue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2563EB;fontColor=#1D4ED8;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ctx-v2-app" target="ctx-v2-queue"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ctx-v2-e10" value="Claim jobs (polling)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#D97706;fontColor=#92400E;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="ctx-v2-queue" target="ctx-v2-worker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ctx-v2-e11" value="Clicks · labelled links · QR zips · totals" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#4F46E5;fontColor=#3730A3;exitX=0.25;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="ctx-v2-worker" target="ctx-v2-pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ctx-v2-note" value="&lt;b&gt;Switch on:&lt;/b&gt; set QUEUE_DRIVER=pgboss for the app and the worker, then run npm run worker. pg-boss creates its pgboss schema on first start. No new service: the queue lives in the PostgreSQL you already have. With a worker queue, a click the queue cannot take is saved directly, so no visit is lost." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#93C5FD;fontSize=11;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1200" height="70" as="geometry" /></mxCell>
