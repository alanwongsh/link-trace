        <mxCell id="flows-t13" value="V1: limited by the request time. V2/V3: worker, no limit." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#92400E;" vertex="1" parent="1"><mxGeometry x="1240" y="300" width="150" height="80" as="geometry" /></mxCell>
