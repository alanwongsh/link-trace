        <mxCell id="scope-t14" value="Moving between versions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="600" height="28" as="geometry" /></mxCell>
        <mxCell id="scope-s1" value="&lt;b&gt;V1 → V2&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set QUEUE_DRIVER=pgboss for the app and the worker · run npm run worker on a server or container (Supabase session pooler) · no migration: pg-boss creates its own schema." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="450" height="120" as="geometry" /></mxCell>
        <mxCell id="scope-s2" value="&lt;b&gt;V2 → V3&lt;/b&gt;&lt;br&gt;&lt;br&gt;Write BullMqDriver + add REDIS_URL · stop adding jobs and let the pgboss queue empty · set QUEUE_DRIVER=bullmq for the app and the workers." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="520" y="880" width="450" height="120" as="geometry" /></mxCell>
        <mxCell id="scope-s3" value="&lt;b&gt;Back down&lt;/b&gt;&lt;br&gt;&lt;br&gt;Any version can go back the same way: let the current queue empty, then change QUEUE_DRIVER. Data never moves; only where jobs wait." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1000" y="880" width="450" height="120" as="geometry" /></mxCell>
      </root>
