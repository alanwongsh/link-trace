        <mxCell id="ctx-v1-staff" value="&lt;b&gt;Staff (browser)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;Sign in · links · labels (parameters)&lt;br&gt;labelled links · bulk CSV → QR zip · reports&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#111827;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="ctx-v1-visitors" value="&lt;b&gt;Visitors&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;QR scans · link clicks&lt;br&gt;/r/:slug · /r/:slug/:tag · /q/:code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#111827;fontSize=14;" vertex="1" parent="1"><mxGeometry x="680" y="130" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="ctx-v1-e4" value="Sign in · manage · upload CSV" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#6B7280;fontColor=#6B7280;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="ctx-v1-staff" target="ctx-v1-app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ctx-v1-e5" value="Scan / click → 302" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#6B7280;fontColor=#6B7280;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="ctx-v1-visitors" target="ctx-v1-app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ctx-v1-app" value="&lt;b&gt;Next.js on Vercel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#DBEAFE&quot;&gt;UI + server actions · auth/sessions · workspace roles · redirects /r and /q → 302&lt;br&gt;enqueue(job) → InlineDriver: the job runs here, after the response (after())&lt;br&gt;record-click · bulk-placements · bulk-cleanup · click-rollup · rebuild-totals&lt;br&gt;No clock: report pages start click-rollup when totals are behind; bulk-cleanup after each upload&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="270" width="600" height="104" as="geometry" /></mxCell>
        <mxCell id="ctx-v1-t6" value="DATA — POSTGRESQL (SUPABASE)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#9CA3AF;" vertex="1" parent="1"><mxGeometry x="56" y="418" width="400" height="20" as="geometry" /></mxCell>
        <mxCell id="ctx-v1-pg" value="&lt;b&gt;PostgreSQL — app data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;users · workspaces (timezone) · memberships · audit_log&lt;br&gt;links (tags) · clicks · labelled links (placements, values)&lt;br&gt;click_daily · click_daily_link · click_daily_dim (report totals)&lt;br&gt;bulk_jobs (status, progress, QR zip for 7 days)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="440" width="600" height="112" as="geometry" /></mxCell>
        <mxCell id="ctx-v1-t7" value="WORKER" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#9CA3AF;" vertex="1" parent="1"><mxGeometry x="56" y="598" width="300" height="20" as="geometry" /></mxCell>
        <mxCell id="ctx-v1-none" value="&lt;b&gt;No worker · no queue · no Redis&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;Jobs get one attempt; failures are logged&lt;br&gt;Bulk QR must finish within the request time limit (maxDuration)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#6B7280;dashed=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="615" width="400" height="70" as="geometry" /></mxCell>
        <mxCell id="ctx-v1-e8" value="Reads/writes · inline jobs (clicks, bulk QR, totals)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2563EB;fontColor=#1D4ED8;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ctx-v1-app" target="ctx-v1-pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ctx-v1-note" value="&lt;b&gt;V1 intent:&lt;/b&gt; prove labels, labelled links, bulk QR and reports with the least infrastructure: two managed services and nothing to run. Every job still goes through enqueue(), so moving to V2 or V3 changes a setting and a driver, not the app." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontColor=#1E3A8A;fillColor=#EFF6FF;strokeColor=#93C5FD;fontSize=11;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1200" height="70" as="geometry" /></mxCell>
        <mxCell id="ctx-v1-legend" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E5E7EB;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1200" height="70" as="geometry" /></mxCell>
