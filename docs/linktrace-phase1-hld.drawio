        <mxCell id="p1-context-queue" value="&lt;b&gt;Job queue (pgboss schema) — optional&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;Only with QUEUE_DRIVER=pgboss&lt;br&gt;Same database, no extra service&lt;br&gt;bulk-placements · bulk-cleanup · record-click&lt;br&gt;Retries · schedules · one worker per job&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#111827;fontSize=14;" vertex="1" parent="1"><mxGeometry x="690" y="430" width="380" height="110" as="geometry" /></mxCell>
        <mxCell id="p1-context-worker" value="&lt;b&gt;Node.js worker (npm run worker) — optional&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;Same jobs as inline: placements · QR zip · click batches&lt;br&gt;Needs a server or container (not Vercel)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#111827;fontSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="610" width="400" height="74" as="geometry" /></mxCell>
