        <mxCell id="ver-overview-v3-clients" value="&lt;b&gt;Staff · visitors&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;Browser · QR scans · /r and /q links&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1075" y="160" width="300" height="44" as="geometry" /></mxCell>
        <mxCell id="ver-overview-v1-app" value="&lt;b&gt;Next.js on Vercel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#DBEAFE&quot;&gt;UI · auth · redirects&lt;br&gt;Jobs run here, after the response&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="115" y="236" width="300" height="74" as="geometry" /></mxCell>
        <mxCell id="ver-overview-v1-pg" value="&lt;b&gt;PostgreSQL (Supabase)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;App data · daily totals · QR zips&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="115" y="350" width="300" height="64" as="geometry" /></mxCell>
        <mxCell id="ver-overview-v1-none" value="No queue · no worker · no Redis" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#6B7280;dashed=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="115" y="450" width="300" height="50" as="geometry" /></mxCell>
