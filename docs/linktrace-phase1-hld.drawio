        <mxCell id="p1-flows-f3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#A7F3D0;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1360" height="250" as="geometry" /></mxCell>
        <mxCell id="p1-flows-t13" value="3. Scan / click → redirect + click saved" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="56" y="440" width="600" height="24" as="geometry" /></mxCell>
        <mxCell id="p1-flows-f3a" value="Visitor hits&#xa;/r/:slug[/:tag]&#xa;or /q/:code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#111827;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="490" width="140" height="70" as="geometry" /></mxCell>
        <mxCell id="p1-flows-f3b" value="Look up link or&#xa;placement in&#xa;PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="260" y="490" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="p1-flows-f3c" value="302 redirect&#xa;immediately" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="490" width="130" height="70" as="geometry" /></mxCell>
        <mxCell id="p1-flows-f3d" value="enqueue record-click&#xa;after the response&#xa;(inline: saved now)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="640" y="490" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="p1-flows-f3e" value="clicks row&#xa;(tag · placement ·&#xa;bot flag)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="870" y="490" width="170" height="70" as="geometry" /></mxCell>
        <mxCell id="p1-flows-f3f" value="With QUEUE_DRIVER=pgboss:&#xa;waits in the queue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#111827;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="640" y="590" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="p1-flows-f3g" value="Worker batch-inserts&#xa;(once per click id)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#111827;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="870" y="590" width="170" height="70" as="geometry" /></mxCell>
        <mxCell id="p1-flows-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#6B7280;" edge="1" parent="1" source="p1-flows-f3a" target="p1-flows-f3b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-flows-e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#2563EB;" edge="1" parent="1" source="p1-flows-f3b" target="p1-flows-f3c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-flows-e16" value="non-blocking" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#2563EB;fontColor=#1D4ED8;fontSize=10;dashed=1;" edge="1" parent="1" source="p1-flows-f3c" target="p1-flows-f3d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-flows-e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#059669;" edge="1" parent="1" source="p1-flows-f3d" target="p1-flows-f3e"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-flows-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#D97706;dashed=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1-flows-f3c" target="p1-flows-f3f"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-flows-e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#D97706;" edge="1" parent="1" source="p1-flows-f3f" target="p1-flows-f3g"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-flows-e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#4F46E5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="p1-flows-f3g" target="p1-flows-f3e"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-flows-t21" value="Placements made from tags (tags:migrate) also count /r/:slug/:tag visits.&#xa;&#xa;With a worker queue, a click the queue cannot take is saved directly, so no visit is lost." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#065F46;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1080" y="500" width="300" height="160" as="geometry" /></mxCell>
        <mxCell id="p1-flows-f4" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#C4B5FD;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1360" height="140" as="geometry" /></mxCell>
        <mxCell id="p1-flows-t22" value="4. Single QR code (on demand, no queue)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#5B21B6;" vertex="1" parent="1"><mxGeometry x="56" y="710" width="600" height="24" as="geometry" /></mxCell>
        <mxCell id="p1-flows-f4a" value="Staff clicks QR on&#xa;link / tag /&#xa;placement" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#111827;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="750" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="p1-flows-f4b" value="/stats/:slug/qr&#xa;renders PNG or SVG" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="270" y="750" width="170" height="70" as="geometry" /></mxCell>
        <mxCell id="p1-flows-f4c" value="Preview or&#xa;download" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#111827;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="490" y="750" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="p1-flows-e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#6B7280;" edge="1" parent="1" source="p1-flows-f4a" target="p1-flows-f4b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-flows-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#2563EB;" edge="1" parent="1" source="p1-flows-f4b" target="p1-flows-f4c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-flows-f5" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#D1D5DB;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1360" height="140" as="geometry" /></mxCell>
        <mxCell id="p1-flows-t25" value="5. Dashboard &amp; link stats" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="56" y="870" width="600" height="24" as="geometry" /></mxCell>
        <mxCell id="p1-flows-f5a" value="Dashboard / link&#xa;page (workspace&#xa;filter)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="910" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="p1-flows-f5b" value="Aggregate clicks in&#xa;PostgreSQL (bots&#xa;left out)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="270" y="910" width="170" height="70" as="geometry" /></mxCell>
        <mxCell id="p1-flows-f5c" value="Totals · 30-day chart ·&#xa;platforms · places ·&#xa;per-placement counts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="490" y="910" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="p1-flows-e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#2563EB;" edge="1" parent="1" source="p1-flows-f5a" target="p1-flows-f5b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-flows-e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#059669;" edge="1" parent="1" source="p1-flows-f5b" target="p1-flows-f5c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-flows-t28" value="Reports grouped by any parameter, device and CSV export come in task 7." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="740" y="920" width="600" height="50" as="geometry" /></mxCell>
      </root>
