  </diagram>
  <diagram id="p1-scope" name="Phase 1 PoC Scope &amp; Data">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1-scope-t0" value="Phase 1 PoC Scope, Data Model &amp; Path to Redis" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="800" height="36" as="geometry" /></mxCell>
        <mxCell id="p1-scope-in" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#6EE7B7;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="600" height="230" as="geometry" /></mxCell>
        <mxCell id="p1-scope-t1" value="In the PoC (built)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="56" y="92" width="300" height="24" as="geometry" /></mxCell>
        <mxCell id="p1-scope-t2" value="• Built-in auth, workspaces, viewer / editor / owner roles, audit log&lt;br&gt;• Links with platform tags (existing, unchanged)&lt;br&gt;• Tracking parameters per workspace: text or dropdown, CSV options&lt;br&gt;• Placements: one QR / spot each at /q/:code, with labels&lt;br&gt;• Bulk CSV → placements + QR zip, after the response (no worker needed)&lt;br&gt;• Dashboard: totals, 30-day chart, platforms, places&lt;br&gt;• tags:migrate script: tags → platform parameter + placements&lt;br&gt;• Jobs via enqueue(): inline by default, pg-boss worker optional" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#064E3B;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="124" width="570" height="180" as="geometry" /></mxCell>
        <mxCell id="p1-scope-out" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#FECACA;arcSize=8;" vertex="1" parent="1"><mxGeometry x="680" y="80" width="600" height="230" as="geometry" /></mxCell>
        <mxCell id="p1-scope-t3" value="Not in the PoC (rest of Phase 1, then later)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="696" y="92" width="400" height="24" as="geometry" /></mxCell>
        <mxCell id="p1-scope-t4" value="• Device routing (iOS / Android / fallback URLs) — task 6&lt;br&gt;• Reports by parameter + CSV export — task 7&lt;br&gt;• Bot and data-centre filtering — task 8&lt;br&gt;• PDPA changes after DPO review — task 9&lt;br&gt;• AWS hosting, CI/CD, branded domain — tasks 10–13&lt;br&gt;• Redis + BullMQ (when click volume needs it)&lt;br&gt;• S3 for QR zips instead of the database&lt;br&gt;• Role-based control beyond workspace roles" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#7F1D1D;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="696" y="124" width="570" height="180" as="geometry" /></mxCell>
        <mxCell id="p1-scope-t5" value="Logical data model (Phase 1)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="400" height="28" as="geometry" /></mxCell>
        <mxCell id="p1-scope-ws" value="&lt;b&gt;workspaces&lt;/b&gt;&lt;hr&gt;id&lt;br&gt;name&lt;br&gt;(memberships: user, role)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="200" height="120" as="geometry" /></mxCell>
        <mxCell id="p1-scope-users" value="&lt;b&gt;users&lt;/b&gt;&lt;hr&gt;id · email&lt;br&gt;is_org_admin&lt;br&gt;(sessions, audit_log)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="200" height="120" as="geometry" /></mxCell>
        <mxCell id="p1-scope-links" value="&lt;b&gt;links&lt;/b&gt;&lt;hr&gt;id · slug (unique)&lt;br&gt;workspace_id FK&lt;br&gt;kind · url / html&lt;br&gt;tags text[]&lt;br&gt;created_by" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=6;" vertex="1" parent="1"><mxGeometry x="290" y="380" width="200" height="150" as="geometry" /></mxCell>
        <mxCell id="p1-scope-clicks" value="&lt;b&gt;clicks&lt;/b&gt;&lt;hr&gt;id · link_id FK&lt;br&gt;visitor_id · ip · ua&lt;br&gt;country · is_bot&lt;br&gt;tag&lt;br&gt;placement_id FK (nullable)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=6;" vertex="1" parent="1"><mxGeometry x="290" y="560" width="200" height="150" as="geometry" /></mxCell>
        <mxCell id="p1-scope-params" value="&lt;b&gt;tracking_parameters&lt;/b&gt;&lt;hr&gt;id · workspace_id FK&lt;br&gt;key (fixed) · name&lt;br&gt;field_type&lt;br&gt;is_required · is_active&lt;br&gt;sort_order" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=6;" vertex="1" parent="1"><mxGeometry x="540" y="380" width="200" height="150" as="geometry" /></mxCell>
        <mxCell id="p1-scope-options" value="&lt;b&gt;tracking_parameter_options&lt;/b&gt;&lt;hr&gt;id · parameter_id FK&lt;br&gt;value (fixed) · label&lt;br&gt;is_active · sort_order" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=6;" vertex="1" parent="1"><mxGeometry x="540" y="560" width="200" height="120" as="geometry" /></mxCell>
        <mxCell id="p1-scope-placements" value="&lt;b&gt;placements&lt;/b&gt;&lt;hr&gt;id · code (unique)&lt;br&gt;link_id FK · name&lt;br&gt;legacy_tag (from tags)&lt;br&gt;bulk_job_id FK&lt;br&gt;is_active" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=6;" vertex="1" parent="1"><mxGeometry x="790" y="380" width="200" height="150" as="geometry" /></mxCell>
        <mxCell id="p1-scope-values" value="&lt;b&gt;placement_values&lt;/b&gt;&lt;hr&gt;placement_id FK&lt;br&gt;parameter_id FK&lt;br&gt;option_id FK · value" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=6;" vertex="1" parent="1"><mxGeometry x="790" y="560" width="200" height="120" as="geometry" /></mxCell>
        <mxCell id="p1-scope-bulk" value="&lt;b&gt;bulk_jobs&lt;/b&gt;&lt;hr&gt;id · link_id FK&lt;br&gt;status · format&lt;br&gt;rows jsonb · total&lt;br&gt;processed · error&lt;br&gt;zip bytea · expires_at" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1040" y="380" width="200" height="150" as="geometry" /></mxCell>
        <mxCell id="p1-scope-pgboss" value="&lt;b&gt;pgboss.* (queue)&lt;/b&gt;&lt;hr&gt;job · queue · schedule&lt;br&gt;managed by pg-boss&lt;br&gt;no app foreign keys" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#111827;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1040" y="560" width="200" height="120" as="geometry" /></mxCell>
        <mxCell id="p1-scope-e6" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#059669;fontColor=#065F46;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="p1-scope-ws" target="p1-scope-links"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-scope-e7" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#059669;fontColor=#065F46;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="p1-scope-links" target="p1-scope-clicks"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-scope-e8" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#059669;fontColor=#065F46;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="p1-scope-ws" target="p1-scope-params"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-scope-e9" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#059669;fontColor=#065F46;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="p1-scope-params" target="p1-scope-options"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-scope-e10" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#059669;fontColor=#065F46;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="p1-scope-links" target="p1-scope-placements"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-scope-e11" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#059669;fontColor=#065F46;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="p1-scope-placements" target="p1-scope-values"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-scope-e12" value="0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#059669;fontColor=#065F46;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="p1-scope-placements" target="p1-scope-clicks"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-scope-e13" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#059669;fontColor=#065F46;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="p1-scope-bulk" target="p1-scope-placements"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-scope-t14" value="Deployment (PoC: 2 processes; 3 with the optional worker; no Redis)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="700" height="28" as="geometry" /></mxCell>
        <mxCell id="p1-scope-d1" value="&lt;b&gt;Next.js&lt;/b&gt;&lt;br&gt;UI · API · auth · redirects" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="220" height="64" as="geometry" /></mxCell>
        <mxCell id="p1-scope-d2" value="&lt;b&gt;Worker (optional)&lt;/b&gt;&lt;br&gt;QUEUE_DRIVER=pgboss" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#111827;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="760" width="220" height="64" as="geometry" /></mxCell>
        <mxCell id="p1-scope-d3" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;app data (+ pgboss queue)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#111827;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="540" y="760" width="260" height="64" as="geometry" /></mxCell>
        <mxCell id="p1-scope-d4" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;not needed in Phase 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#6B7280;dashed=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="830" y="760" width="200" height="64" as="geometry" /></mxCell>
        <mxCell id="p1-scope-t15" value="On Vercel: inline jobs, no worker; bulk uploads run within the request time limit (maxDuration). Add the worker on a server or container (AWS, task 12)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="1060" y="760" width="340" height="64" as="geometry" /></mxCell>
        <mxCell id="p1-scope-t16" value="Path: inline → Postgres queue → Redis + BullMQ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="600" height="28" as="geometry" /></mxCell>
        <mxCell id="p1-scope-evo" value="Jobs are listed once in lib/jobs/catalog.ts and added with enqueue(name, data); QUEUE_DRIVER picks the driver in lib/jobs/create-driver.ts: inline → pgboss → bullmq.&lt;br&gt;Each step: set QUEUE_DRIVER for the app and the worker, letting the old queue empty first. For BullMQ, write a driver with REDIS_URL that batches clicks for record-click.&lt;br&gt;No change to redirects, placements, bulk QR, job status tables or reports." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;fontSize=12;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;verticalAlign=top;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="1360" height="110" as="geometry" /></mxCell>
      </root>
