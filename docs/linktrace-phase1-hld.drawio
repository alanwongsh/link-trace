        <mxCell id="ctx-v1-l1" value="Next.js" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#2563EB;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="56" y="852" width="110" height="26" as="geometry" /></mxCell>
