  <diagram id="mvp-scope" name="MVP Scope &amp; Data">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="stitle" value="MVP Scope, Data Model &amp; Path to Full Design" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="640" height="36" as="geometry" />
        </mxCell>

        <!-- In / Out scope -->
        <mxCell id="in-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#6EE7B7;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="540" height="220" as="geometry" />
        </mxCell>
        <mxCell id="in-title" value="In MVP" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#065F46;" vertex="1" parent="1">
          <mxGeometry x="56" y="92" width="100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="in-body" value="• Next.js auth (email/password or OAuth)&lt;br&gt;• Campaign + short link CRUD&lt;br&gt;• Public redirect /r/:code&lt;br&gt;• Async QR generation (BullMQ)&lt;br&gt;• Async click ingest (BullMQ)&lt;br&gt;• Basic analytics dashboard&lt;br&gt;• PostgreSQL as single source of truth" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="56" y="124" width="500" height="160" as="geometry" />
        </mxCell>

        <mxCell id="out-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="80" width="540" height="220" as="geometry" />
        </mxCell>
        <mxCell id="out-title" value="Out of MVP (later / full HLD)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#991B1B;" vertex="1" parent="1">
          <mxGeometry x="636" y="92" width="280" height="24" as="geometry" />
        </mxCell>
        <mxCell id="out-body" value="• Joget portal entrance / SSO&lt;br&gt;• User-configured process workflows&lt;br&gt;• Campaign approval chains&lt;br&gt;• Joget webhook status sync&lt;br&gt;• Multi-tenant org hierarchy (optional)&lt;br&gt;• Geo enrichment / CDN for QR assets&lt;br&gt;• Advanced analytics / exports" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#7F1D1D;" vertex="1" parent="1">
          <mxGeometry x="636" y="124" width="500" height="160" as="geometry" />
        </mxCell>

        <!-- Data model -->
        <mxCell id="dm-title" value="Logical data model (MVP)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="280" height="28" as="geometry" />
        </mxCell>

        <mxCell id="tbl-users" value="&lt;b&gt;users&lt;/b&gt;&lt;hr&gt;id&lt;br&gt;email&lt;br&gt;password_hash&lt;br&gt;name&lt;br&gt;created_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=12;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="180" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tbl-campaigns" value="&lt;b&gt;campaigns&lt;/b&gt;&lt;hr&gt;id&lt;br&gt;user_id FK&lt;br&gt;name&lt;br&gt;status (draft/active)&lt;br&gt;created_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=12;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="260" y="370" width="180" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tbl-links" value="&lt;b&gt;links&lt;/b&gt;&lt;hr&gt;id&lt;br&gt;campaign_id FK&lt;br&gt;code (unique)&lt;br&gt;destination_url&lt;br&gt;qr_url&lt;br&gt;created_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=12;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="480" y="370" width="180" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tbl-clicks" value="&lt;b&gt;click_events&lt;/b&gt;&lt;hr&gt;id&lt;br&gt;link_id FK&lt;br&gt;ts&lt;br&gt;ua&lt;br&gt;ip_hash&lt;br&gt;meta jsonb" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=12;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="700" y="370" width="180" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tbl-jobs" value="&lt;b&gt;BullMQ (Redis)&lt;/b&gt;&lt;hr&gt;qr-generation&lt;br&gt;{ linkId, url, size }&lt;br&gt;&lt;br&gt;click-ingest&lt;br&gt;{ linkId, ts, ua,&lt;br&gt;ipHash, meta }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=12;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="920" y="370" width="200" height="160" as="geometry" />
        </mxCell>

        <mxCell id="rel1" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;fontColor=#065F46;fontSize=11;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="tbl-users" target="tbl-campaigns">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel2" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;fontColor=#065F46;fontSize=11;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="tbl-campaigns" target="tbl-links">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel3" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;fontColor=#065F46;fontSize=11;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="tbl-links" target="tbl-clicks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Evolution -->
        <mxCell id="evo-title" value="Evolution to full design (with Joget)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="360" height="28" as="geometry" />
        </mxCell>
        <mxCell id="evo-box" value="MVP core stays: Next.js · PostgreSQL · Redis/BullMQ · Worker.&lt;br&gt;Later add: Joget as entrance + workflow engine; Next.js calls process/start on campaign create; optional webhook updates campaign.status / joget_process_id.&lt;br&gt;No rewrite of redirect, QR, or click-ingest paths." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;fontSize=12;align=left;spacingLeft=14;spacingRight=14;spacingTop=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1080" height="90" as="geometry" />
        </mxCell>

        <!-- Deploy -->
